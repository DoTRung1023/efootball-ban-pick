# ============================================================
# Every variable this app reads. Placeholders only — this is the one env file
# that is committed.
#
# There are three, and only the first is ever loaded:
#
#   .env              what runs on your machine. Copy this file to it.
#   .env.production   the deployment's values, pasted into the host's env
#                     editor. Never loaded by the app. Gitignored.
#   .env.example      this file.
#
# `dotenv/config` reads `.env` and nothing else, so a value that is only in
# .env.production has no effect locally, and vice versa. On the host there is no
# .env at all — the platform's own environment supplies these, and dotenv never
# overwrites a variable that is already set.
#
# Nothing here is required to boot: db.js falls back to root@localhost/
# ban_pick_efb, and every optional feature says at startup when it is off.
# ============================================================

# ── Database ───────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ban_pick_efb
# Any value requires TLS. Every managed MySQL needs it; a local socket cannot
# use it. Leave empty locally.
DB_SSL=
# The provider's own root certificate, PEM and all, where it uses one — Aiven
# ships a ca.pem. TiDB Cloud is publicly signed and needs nothing here.
DB_CA=

# Locally the app takes 3000 when this is unset. On a host, leave it unset:
# the platform supplies it, and a hard-coded port fails the health check.
PORT=

# ── Sessions ───────────────────────────────────────────────
# Signs the sign-in cookie and the console token. Random per boot when unset,
# which means every restart signs everyone out — right on a laptop, wrong on a
# deployment.
SESSION_SECRET=
ADMIN_SECRET=

# ── Behind a proxy ─────────────────────────────────────────
# Both only matter where something terminates TLS in front of the app, and both
# break something quiet when missing: emailed links come out as http://, and the
# rate limiter buckets the whole internet together as one caller.
APP_BASE_URL=https://your-app.example.com
TRUST_PROXY=1

# ── The built-in admin ─────────────────────────────────────
# Re-applied on every boot, so this pair is the way back in after a forgotten
# password. With none of it set, the first boot against an admin-less database
# generates one and prints it to the log exactly once.
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# One shared password for the /console gate, so admins stop retyping their own.
# Leave unset and the account's own password is used instead.
ADMIN_CONSOLE_PASSWORD=
# Set to 1 to rewrite the stored hash from the line above on every boot.
# Without it that value only seeds, and a rotation made inside the console wins.
ADMIN_CONSOLE_PASSWORD_RESET=

# ── Email ──────────────────────────────────────────────────
# Unset SMTP_HOST prints both messages — the sign-up confirmation link and a
# console-generated password — to the server log instead of sending them. Fine
# locally; on a deployment it means nobody can finish signing up.
SMTP_HOST=
# 465 is TLS-on-connect; anything else uses STARTTLS.
# NOTE: Render blocks outbound 25, 465 and 587 on free web services. Brevo also
# listens on 2525, which is not blocked.
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="eFootball Ban & Pick <you@example.com>"

# ── Card images — Cloudflare R2 (optional) ─────────────────
# Inactive until the keys are set; until then /img/card/:id.png redirects to
# pesdb.net and the app works normally.
R2_BUCKET=
R2_REGION=auto
# The bucket name does NOT belong in the endpoint — it is passed separately.
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Only for a bucket with a public domain. Setting it while the bucket is
# private breaks every card image.
R2_PUBLIC_BASE_URL=

# ── Dev only ───────────────────────────────────────────────
# Makes the scraper print its progress and the last 5 runs.
SCRAPE_SHOW_LOGS=
