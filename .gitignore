node_modules/
.env
# Every other .env — .env.production carries live deployment secrets and is
# meant to be pasted into a host's env editor, never committed. The example
# is the one that stays, because it holds placeholders and nothing else.
.env.*
*.log
.DS_Store
.scrape-state.json
database/backups/

# Test harnesses are written into the served directory and deleted afterwards —
# `verify-layout`'s probe, the smoke page in `checks.md`. One survived a crashed
# run and got committed; this makes that impossible.
public/__*.html
