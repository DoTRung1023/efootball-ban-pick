HOST=gateway01-privatelink.ap-southeast-1.prod.aws.tidbcloud.com
USER='kM6eunYAgSPavj4.root'

# 1. schema (creates the ban_pick_efb database itself)
mysql --host $HOST --port 4000 --user $USER -p \
  --ssl-mode=VERIFY_IDENTITY --ssl-ca=/etc/ssl/cert.pem \
  < database/schema.sql

# 2. the 41k-row catalog, data only, straight from your local MySQL (~15 MB)
mysqldump -u root --no-create-info --no-tablespaces --set-gtid-purged=OFF \
  ban_pick_efb players_catalog > /tmp/catalog.sql

mysql --host $HOST --port 4000 --user $USER -p \
  --ssl-mode=VERIFY_IDENTITY --ssl-ca=/etc/ssl/cert.pem \
  ban_pick_efb < /tmp/catalog.sql

# 3. sanity check
mysql --host $HOST --port 4000 --user $USER -p \
  --ssl-mode=VERIFY_IDENTITY --ssl-ca=/etc/ssl/cert.pem \
  ban_pick_efb -e "SELECT COUNT(*) FROM players_catalog;"